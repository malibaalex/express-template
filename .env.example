# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
PORT=4001
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# Used by docker-compose to create the Postgres container and to build the
# api's DATABASE_URL. Keep them in sync with DATABASE_URL below.
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=app_db

# Used when running the app on your machine (pnpm dev, prisma migrate dev).
# Inside Docker, compose overrides this to point at the "db" service.
# If the password has special characters (@ : / # ?), URL-encode them.
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/app_db

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------
# Generate each secret with: openssl rand -base64 48
# Expiry values are in seconds.

# Access token (900 = 15 minutes)
JWT_ACCESS_SECRET_KEY=your_access_secret_key_here
JWT_ACCESS_SECRET_KEY_EXPIRES_IN=900

# Refresh token (604800 = 7 days, 2592000 = 30 days, 7776000 = 90 days)
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key_here
JWT_REFRESH_SECRET_KEY_EXPIRES_IN=604800